# Base de datos (docker-compose.dev.yml)
DATABASE_URL=mysql://ffm:devffmpass@localhost:3306/firefly_manager

# Firefly III
FF3_URL=http://localhost:8080
FF3_TOKEN=changeme

# Reglas de matching
MATCH_TOLERANCE_DAYS=0

# Logs
RUST_LOG=ffm_presentation=info,ffm_application=info,ffm_infrastructure=info,tower_http=info

# Firefly III health probe (set to "true" to enable FF3 check in /health)
FF3_HEALTH_PROBE=false