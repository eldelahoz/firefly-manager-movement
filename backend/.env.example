# Base de datos SQLite (archivo creado si no existe; en el contenedor: /data/ffm.db)
DATABASE_URL=./ffm.db

# Firefly III
FF3_URL=http://localhost:8080
FF3_TOKEN=changeme

# Reglas de matching
MATCH_TOLERANCE_DAYS=0

# Built frontend (dist/) served by the backend; unset in dev (Vite serves it)
# FRONTEND_DIST=../frontend/dist

# Logs
RUST_LOG=ffm_presentation=info,ffm_application=info,ffm_infrastructure=info,tower_http=info

# Firefly III health probe (set to "true" to enable FF3 check in /health)
FF3_HEALTH_PROBE=false