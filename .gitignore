# Root Node dev tooling (commitlint + lefthook only; frontend/ has its own .gitignore)
/node_modules/

.env

# Obsidian vault over docs/ - everything under docs/.obsidian/ is ignored
# except the curated config whitelisted below (volatile files stay local).
docs/.obsidian/**
!docs/.obsidian/app.json
!docs/.obsidian/appearance.json
!docs/.obsidian/core-plugins.json
!docs/.obsidian/community-plugins.json
!docs/.obsidian/snippets/
docs/.obsidian/snippets/**
!docs/.obsidian/snippets/docs-reading.css
!docs/.obsidian/themes/
docs/.obsidian/themes/**
!docs/.obsidian/themes/Minimal/
!docs/.obsidian/themes/Minimal/**