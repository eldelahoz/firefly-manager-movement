# Firefly III APP_KEY — generate with:
#   Linux / WSL / macOS:  echo "FF3_APP_KEY=base64:$(openssl rand -base64 32)" > .env
#   Windows (PowerShell):  see README step 1
#
# Do NOT change after Firefly III has data (used to encrypt sensitive fields).
# Do NOT commit the real .env file (it is gitignored).
FF3_APP_KEY=
